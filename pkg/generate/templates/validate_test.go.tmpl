{{define "validate_test.go.tmpl"}}//nolint:lll // Generated tests embed the complete source document.
package {{.Package}}

import (
	"errors"
	"testing"

	"github.com/djosh34/klopt/pkg/patternvalidator"
	testgenerator "github.com/djosh34/klopt/pkg/test_generator"
	"github.com/djosh34/klopt/pkg/validation"
)

// openAPI is the source document used to compile the generated request validations.
var openAPI = []byte({{.OpenAPI}})

// validateBody adapts the generated validation map to the request-body runner.
func validateBody(operationID string, data []byte) error {
	return errors.Join(RequestValidations[operationID].Body.Validate(data)...)
}

// FuzzValidations lets native Go fuzzing steer one document-wide graph program.
func FuzzValidations(f *testing.F) {
	compiled, err := testgenerator.Compile(
		openAPI,
		validation.PatternOptions(
			{{if .Pattern.RejectNonASCII}}patternvalidator.RejectNonASCII,{{end}}
			{{if .Pattern.UseRE2}}patternvalidator.UseRE2,{{end}}
		),
	)
	if err != nil {
		f.Fatal(err)
	}
	defer compiled.Close()

	f.Add([]byte{})
	f.Fuzz(func(t *testing.T, input []byte) {
		if compiled.Empty() {
			return
		}

		sample, err := compiled.Decode(input)
		if err != nil {
			if testgenerator.ResourceLimited(err) {
				return
			}

			t.Fatal(err)
		}

		if err := compiled.Check(sample, validateBody); err != nil {
			t.Fatal(err)
		}
	})
}
